# Copy to .env (in this same folder) and adjust. Never commit .env.
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# DATABASE_URL=postgres://user:pass@localhost:5432/reviews
APP_TIME_ZONE=Asia/Kolkata
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Scraper politeness / reliability
SCRAPER_REQUEST_DELAY_SECONDS=3
SCRAPER_MAX_RETRIES=4
SCRAPER_TIMEOUT_SECONDS=30
SCRAPER_MAX_PAGES_PER_RUN=200
SCRAPER_INCREMENTAL_STOP_AFTER_KNOWN_PAGES=2
# Days of review history to collect (0 = everything Booking lists)
SCRAPER_HISTORY_DAYS=365
